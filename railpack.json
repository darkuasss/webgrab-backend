{
  "$schema": "https://schema.railpack.com",
  "buildAptPackages": ["wkhtmltopdf", "fontconfig", "fonts-dejavu-core"],

  "steps": {
    "install": {
      "commands": [
        "...",
        {
          "customName": "Install Playwright Chromium",
          "cmd": "bash -lc \"mkdir -p /app/pw-browsers && PLAYWRIGHT_BROWSERS_PATH=/app/pw-browsers python -m playwright install --with-deps chromium\""
        }
      ]
    }
  },

  "deploy": {
    "aptPackages": ["wkhtmltopdf", "fontconfig", "fonts-dejavu-core"],
    "variables": {
      "PLAYWRIGHT_BROWSERS_PATH": "/app/pw-browsers"
    }
  }
}
