{
  "$schema": "https://schema.railpack.com",
  "buildAptPackages": ["wkhtmltopdf", "fontconfig", "fonts-dejavu-core"],
  "steps": {
    "install": {
      "commands": [
        "...",
        { "cmd": "mkdir -p /app/pw-browsers", "customName": "Create Playwright browsers dir" },
        { "cmd": "python -m playwright install --with-deps chromium", "customName": "Install Playwright Chromium" }
      ]
    }
  },
  "deploy": {
    "aptPackages": ["wkhtmltopdf", "fontconfig", "fonts-dejavu-core"]
  }
}
